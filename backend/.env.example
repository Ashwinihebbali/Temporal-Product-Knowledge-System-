# Copy this to .env to enable PostgreSQL + Neo4j. Without DATABASE_URL,
# the backend continues to use chronodev_features.sqlite3.
DATABASE_URL=postgresql://chronodev:chronodev-local@localhost:5432/chronodev
POSTGRES_PASSWORD=chronodev-local
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=chronodev-local
NEO4J_DATABASE=neo4j
GRAPH_SYNC_INTERVAL_SECONDS=10

# Existing local AI settings can also be set here:
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
USE_OLLAMA=true
